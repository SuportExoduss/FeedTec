{
  "expo": {
    "name": "FeedTec",
    "slug": "feedtec",
    "scheme": "feedtec",
    "version": "0.2.3",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#101214",
    "android": {
      "package": "com.trevotec.feedtec",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "feedtec.web.app" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "output": "single",
      "name": "FeedTec",
      "shortName": "FeedTec",
      "themeColor": "#101214",
      "backgroundColor": "#101214"
    },
    "plugins": [
      "./plugins/local-properties",
      "./plugins/android-studio",
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#101827"
        }
      ],
      "expo-status-bar",
      "expo-audio",
      "expo-notifications",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O FeedTec usa a câmera para anexar fotos às ocorrências.",
          "photosPermission": "O FeedTec abre a galeria para anexar fotos às ocorrências."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
