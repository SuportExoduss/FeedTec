    "expo-document-picker": "~58.0.4",
    "expo-font": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.26",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "firebase": "^13.1.0",
    "react": "19.3.0",
