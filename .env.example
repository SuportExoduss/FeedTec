# Copie para .env.local e preencha (Console Firebase > Configurações do projeto > App da Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Login Google no Android (Google Cloud > Credenciais > ID do cliente OAuth do tipo "Web")
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

